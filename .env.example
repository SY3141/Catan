# Optional. When set, replay logs are stored in Postgres instead of web-log-dir files.
# Use sslmode=require for managed/production Postgres providers.
DATABASE_URL=postgres://hexfish:hexfish@localhost:5432/hexfish?sslmode=disable

# Optional. Set to true in production so the server fails startup if replay
# storage cannot connect instead of falling back to local files.
HEXFISH_REPLAY_STORE_REQUIRED=false

# Cloud Run + Cloud SQL example. Store the full value in Secret Manager and
# inject it as DATABASE_URL. Replace PROJECT_ID and password before use.
# DATABASE_URL=host=/cloudsql/PROJECT_ID:us-central1:hexfish-postgres port=5432 dbname=hexfish user=hexfish_app password=REPLACE_ME sslmode=disable
