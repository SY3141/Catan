# Optional. Omit or leave empty for fresh anonymous games per WebSocket.
# Set this PEM public key to enable verified per-Clerk-account games.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://romantic-mollusk-80.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Optional. When set, replay logs are stored in Postgres instead of web-log-dir files.
# Use sslmode=require for managed/production Postgres providers.
DATABASE_URL=postgres://hexfish:hexfish@localhost:5432/hexfish?sslmode=disable
